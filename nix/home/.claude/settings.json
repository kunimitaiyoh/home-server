{
  "permissions": {
    "allow": [
      "Bash(aws logs describe-log-groups *)",
      "Bash(aws logs filter-log-events *)",
      "Bash(aws logs get-function-configuration *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh run view *)",
      "Bash(git check-ignore *)",
      "Bash(git checkout *)",
      "Bash(git fetch *)",
      "Bash(git grep *)",
      "Bash(git ls-remote *)",
      "Bash(git ls-tree *)",
      "Bash(grep *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(pnpm view  *)",
      "Bash(terraform fmt *)",
      "Bash(terraform version *)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(git -C *)"
    ],
    "ask": [
      "Bash(npm *)",
      "Bash(npx *)"
    ],
    "defaultMode": "default"
  },
  "model": "opus[1m]",
  "hooks": {},
  "statusLine": {
    "type": "command",
    "command": "/home/bard/.claude/statusline.sh"
  },
  "language": "Japanese",
  "promptSuggestionEnabled": false,
  "autoMemoryEnabled": false,
  "autoUpdatesChannel": "latest",
  "remoteControlAtStartup": true
}
